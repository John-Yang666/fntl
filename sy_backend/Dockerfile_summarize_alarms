# 基础镜像
FROM python:3.14-slim@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061

# 设置工作目录
WORKDIR /app

ARG APT_MIRROR_HOST=mirrors.ustc.edu.cn
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_DEFAULT_TIMEOUT=180
ARG PIP_RETRIES=10

# 安装必要的系统依赖
RUN sed -i "s|deb.debian.org|${APT_MIRROR_HOST}|g; s|security.debian.org|${APT_MIRROR_HOST}|g" /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY requirements_summarize_alarms.txt /app/requirements_summarize_alarms.txt
RUN python -m pip install --no-cache-dir \
    --default-timeout=${PIP_DEFAULT_TIMEOUT} \
    --retries=${PIP_RETRIES} \
    -i ${PIP_INDEX_URL} \
    --trusted-host ${PIP_TRUSTED_HOST} \
    $(if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then printf '%s ' --extra-index-url ${PIP_EXTRA_INDEX_URL}; fi) \
    -r /app/requirements_summarize_alarms.txt

# 设置默认环境变量
ENV PYTHONUNBUFFERED=1
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379

# 启动命令
CMD ["python", "summarize_alarms_container.py"]
