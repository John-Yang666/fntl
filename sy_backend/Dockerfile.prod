# syntax=docker/dockerfile:1.7

FROM python:3.14-slim@sha256:44dd04494ee8f3b538294360e7c4b3acb87c8268e4d0a4828a6500b1eff50061

# 设置工作目录
WORKDIR /app

ARG APT_MIRROR_HOST=mirrors.ustc.edu.cn
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
ARG PIP_EXTRA_INDEX_URL=
ARG PIP_DEFAULT_TIMEOUT=180
ARG PIP_RETRIES=10

# 安装系统依赖（使用 BuildKit 缓存提升重复构建速度）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sed -i "s|deb.debian.org|${APT_MIRROR_HOST}|g; s|security.debian.org|${APT_MIRROR_HOST}|g" /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends netcat-openbsd build-essential libpq-dev libpq5

# 复制依赖清单和锁文件并安装依赖
COPY requirements.txt /app/
COPY requirements.lock.txt /app/
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -n "${PIP_EXTRA_INDEX_URL}" ]; then \
      python -m pip install \
      --default-timeout=${PIP_DEFAULT_TIMEOUT} \
      --retries=${PIP_RETRIES} \
      -i ${PIP_INDEX_URL} \
      --extra-index-url ${PIP_EXTRA_INDEX_URL} \
      --trusted-host ${PIP_TRUSTED_HOST} \
      -r requirements.txt \
      -c requirements.lock.txt; \
    else \
      python -m pip install \
      --default-timeout=${PIP_DEFAULT_TIMEOUT} \
      --retries=${PIP_RETRIES} \
      -i ${PIP_INDEX_URL} \
      --trusted-host ${PIP_TRUSTED_HOST} \
      -r requirements.txt \
      -c requirements.lock.txt; \
    fi && \
    apt-get purge -y --auto-remove build-essential libpq-dev

# 复制项目文件和脚本到容器中
COPY . /app
COPY wait-for-it.sh /app/wait-for-it.sh
COPY entrypoint-prod.sh /app/entrypoint-prod.sh

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DJANGO_SETTINGS_MODULE=myproject.settings

# 给非 root 运行用户读取源码和执行入口脚本的权限
RUN find /app -type d -exec chmod 755 {} + && \
    find /app -type f -exec chmod 644 {} + && \
    chmod +x /app/wait-for-it.sh && \
    chmod +x /app/entrypoint-prod.sh && \
    groupadd --gid 10001 appuser && \
    useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin appuser && \
    mkdir -p /app/staticfiles /app/media /data/cleanup_exports && \
    chown -R 10001:10001 /app/staticfiles /app/media /data/cleanup_exports

# 设置通用的 ENTRYPOINT 以支持不同命令
# 还有其他容器使用这个Dockerfile所以不能在此执行entrypoint脚本，而是在docker-compose中执行
# ENTRYPOINT ["/app/entrypoint.sh"]

# 默认启动命令，运行Django服务
#CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
USER 10001:10001
CMD ["uvicorn", "myproject.asgi:application", "--host", "0.0.0.0", "--port", "8000"]
