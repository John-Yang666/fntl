########################################
# ============ 构建阶段 ================
########################################
ARG NODE_IMAGE=node:22
ARG NGINX_IMAGE=nginx:1.27-alpine-slim
FROM ${NODE_IMAGE} AS build

WORKDIR /app

# 仅复制依赖清单，最大化命中缓存
COPY package.json package-lock.json ./
COPY npm-cache/ /opt/npm-cache/

# 离线构建时：
# 1. NODE_IMAGE / NGINX_IMAGE 必须已经存在于本地 Docker
# 2. frontend/npm-cache 必须预热过一次
ARG NPM_INSTALL_MODE=online
RUN if [ "$NPM_INSTALL_MODE" = "offline" ]; then \
      if [ ! -d /opt/npm-cache/_cacache ]; then \
        echo "offline npm cache not found in frontend/npm-cache" >&2; \
        echo "warm it once with: npm ci --cache ./npm-cache" >&2; \
        exit 1; \
      fi; \
      npm ci --offline --cache /opt/npm-cache --no-audit --no-fund; \
    else \
      npm ci --no-audit --no-fund; \
    fi

# 透传 Vite 的构建期环境变量（BT / SY 双后端端口）
# docker build/compose 用 --build-arg VITE_BT_BACKEND_PORT=8000 --build-arg VITE_SY_BACKEND_PORT=8001 传入
ARG VITE_BT_BACKEND_PORT
ARG VITE_SY_BACKEND_PORT
ENV VITE_BT_BACKEND_PORT=${VITE_BT_BACKEND_PORT}
ENV VITE_SY_BACKEND_PORT=${VITE_SY_BACKEND_PORT}

# 复制源码（放在依赖安装之后，避免改源码导致重装依赖）
COPY . .

# 生产构建
RUN npm run build


########################################
# ============ 运行阶段 ================
########################################
FROM ${NGINX_IMAGE} AS prod

# 可选：安全基线
# 关闭服务器版本暴露（配合自定义 nginx.conf 更好）
RUN rm -f /etc/nginx/conf.d/default.conf

# 复制自定义 nginx 配置（请保证本地有 nginx.conf）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝静态产物
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
