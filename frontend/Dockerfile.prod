# syntax=docker/dockerfile:1.7

########################################
# ============ 构建阶段 ================
########################################
FROM node:22-alpine AS build

WORKDIR /app

# 仅复制依赖清单，最大化命中缓存
COPY package.json npm-shrinkwrap.json ./

# （可选）国内网络可临时换源；若不需要请注释掉
# RUN npm config set registry https://registry.npmmirror.com

# 使用 BuildKit 缓存 + npm ci（更快、更可重复）
# 有锁用 ci；无锁回退 install（带缓存）
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# 透传 Vite 的构建期环境变量（BT / SY 双后端端口）
# docker build/compose 用 --build-arg VITE_BT_BACKEND_PORT=8000 --build-arg VITE_SY_BACKEND_PORT=8001 传入
ARG VITE_BT_BACKEND_PORT
ARG VITE_SY_BACKEND_PORT
ENV VITE_BT_BACKEND_PORT=${VITE_BT_BACKEND_PORT}
ENV VITE_SY_BACKEND_PORT=${VITE_SY_BACKEND_PORT}

# 复制源码（放在依赖安装之后，避免改源码导致重装依赖）
COPY . .

# 生产构建
RUN npm run build


########################################
# ============ 运行阶段 ================
########################################
FROM nginx:1.27-alpine-slim AS prod

# 可选：安全基线
# 关闭服务器版本暴露（配合自定义 nginx.conf 更好）
RUN rm -f /etc/nginx/conf.d/default.conf

# 复制自定义 nginx 配置（请保证本地有 nginx.conf）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝静态产物
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
