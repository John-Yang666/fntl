{
  "name": "bt-nms-virtual-backend",
  "version": "0.1.0",
  "description": "贝通网管虚拟后端",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "desktop:compile": "tsc -p tsconfig.electron.json",
    "desktop:dev": "run-s build desktop:compile && electron .",
    "desktop:build": "run-s build desktop:compile && electron-builder --publish never",
    "desktop:build:mac": "run-s build desktop:compile && electron-builder --mac dmg zip --publish never",
    "desktop:build:win": "run-s build desktop:compile && electron-builder --win nsis zip --publish never"
  },
  "build": {
    "appId": "com.beitong.nms.virtualbackend",
    "productName": "贝通网管虚拟后端",
    "asar": true,
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "axios": "1.7.7",
    "element-plus": "2.8.7",
    "vue": "3.5.12",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.2",
    "@types/node": "22.9.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "5.1.4",
    "@vue/tsconfig": "0.5.1",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "npm-run-all2": "6.1.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "3.2.4",
    "vue-tsc": "2.1.10"
  }
}
