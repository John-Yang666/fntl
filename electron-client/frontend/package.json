{
  "name": "vue-project-fntl-ms100",
  "version": "0.2.0",
  "description": "贝通网管客户端",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "desktop:compile": "tsc -p tsconfig.electron.json",
    "desktop:dev": "run-s build desktop:compile && electron .",
    "desktop:build": "run-s build desktop:compile && electron-builder --publish never",
    "desktop:build:mac": "run-s build desktop:compile && electron-builder --mac dmg zip --publish never",
    "desktop:build:win": "run-s build desktop:compile && electron-builder --win nsis zip --x64 --publish never"
  },
  "build": {
    "appId": "com.beitong.nms.client",
    "productName": "贝通网管客户端",
    "asar": true,
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "electron/installer.nsh"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.0.1",
    "date-fns": "^4.1.0",
    "element-plus": "^2.8.7",
    "idb": "^7.1.1",
    "pinia": "^2.2.6",
    "pinia-plugin-persistedstate": "^2.0.0",
    "tslib": "^2.8.1",
    "vue": "^3.5.12",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.4.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "npm-run-all2": "^6.1.2",
    "typescript": "^5.6.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
