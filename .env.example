# Copy to .env on the deployment host and replace every value.

DATA_DIR=/srv/bt_nms_data

# Optional for Linux Docker rootless deployments.
# Set both values in the deployment shell or .env when using the rootless daemon.
# Rootless deployments should prefer a data directory owned by the rootless user.
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# DOCKER_HOST_SOCKET=/run/user/1000/docker.sock
# DATA_DIR=/home/bt-nms/bt_nms_data

# BT production backend
BT_DJANGO_SECRET_KEY_SECRET_FILE=./deploy/secrets/bt_django_secret_key
DATABASE_NAME=mydatabase
DATABASE_USER=myuser
BT_DATABASE_PASSWORD_SECRET_FILE=./deploy/secrets/bt_database_password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip-or-domain
CORS_ALLOWED_ORIGINS=http://your-server-ip-or-domain:38173,https://your-server-ip-or-domain:38443
FLOWER_BASIC_AUTH=admin:replace-with-a-strong-flower-password
# Keep false while HTTP remains enabled. Enable only if you intentionally force HTTPS.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_PRELOAD=true

# Optional initial superuser. Leave unset after the first successful deployment.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Alternatively set DJANGO_SUPERUSER_PASSWORD_FILE to a path inside the web container
# from a deployment-specific compose override that mounts the secret file.
DJANGO_SUPERUSER_PASSWORD_FILE=

# SY production backend
SY_DJANGO_SECRET_KEY_SECRET_FILE=./deploy/secrets/sy_django_secret_key
SY_DATABASE_PASSWORD_SECRET_FILE=./deploy/secrets/sy_database_password
SY_DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip-or-domain
SY_CORS_ALLOWED_ORIGINS=http://your-server-ip-or-domain:38173,https://your-server-ip-or-domain:38443
SY_FLOWER_BASIC_AUTH=admin:replace-with-a-strong-sy-flower-password
# Keep false while HTTP remains enabled. Enable only if you intentionally force HTTPS.
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_PRELOAD=true

# Optional initial SY superuser. Leave unset after the first successful deployment.
SY_DJANGO_SUPERUSER_USERNAME=
SY_DJANGO_SUPERUSER_EMAIL=
SY_DJANGO_SUPERUSER_PASSWORD=
SY_DJANGO_SUPERUSER_PASSWORD_FILE=
