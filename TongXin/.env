# =========================
# 统信 UOS（Linux）专用 .env
# =========================

# 项目名（compose 会用它作为默认前缀）
COMPOSE_PROJECT_NAME=bt_nms

# =========================
# 数据目录（统信建议用 /srv 或 /data 这类“业务数据目录”）
# =========================
DATA_DIR=/srv/bt_nms_data

# 备选：如果你们现场更习惯放到 /data
#DATA_DIR=/data/bt_nms_data


# =========================
# Postgres 数据库配置（为兼容老版本 compose：这里显式写死）
# =========================
DATABASE_NAME=mydatabase
DATABASE_USER=myuser
DATABASE_PASSWORD=mypassword
DATABASE_HOST=db
DATABASE_PORT=5432


# =========================
# Django 基础开关
# =========================
DEBUG=false


# =========================
# 其他（先保留注释）
# =========================
#KAFKA_EXTERNAL_ADDR=localhost